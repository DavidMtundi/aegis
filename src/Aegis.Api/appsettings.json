{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Aegis": "Host=localhost;Port=5432;Database=aegis;Username=aegis;Password=aegis_dev_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "aegis",
    "Audience": "aegis-api",
    "AccessTokenMinutes": "120",
    "RefreshTokenDays": 14
  },

  "Aegis": {
    "AllowDevBootstrap": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Limits": {
    "MaxRequestBodyBytes": 10485760
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "aegis-api"
  },
  "AllowedHosts": "*"
}
